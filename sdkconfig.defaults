# sdkconfig.defaults — M4NT1S
#
# sdkconfig.defaults is only read when sdkconfig does not exist.
# To apply changes: delete sdkconfig, then
#     idf.py fullclean
#     idf.py build
# Do not edit sdkconfig directly.

# ---------------------------------------------------------------------------
# Target and flash
# ---------------------------------------------------------------------------
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---------------------------------------------------------------------------
# Stack and heap sizing
#
# 32 KB main task stack was the single largest unnecessary contiguous
# block at boot. 8 KB is plenty for the menu state machine.
# LVGL pool dropped from 64 KB default to 24 KB — adequate for a
# five-screen text UI.
# ---------------------------------------------------------------------------
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_LV_MEM_SIZE=24576

# ---------------------------------------------------------------------------
# Fonts — ui.c uses 14 for the menu, 28 for the backdrop label
# ---------------------------------------------------------------------------
CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_UNSCII_8=y

# ---------------------------------------------------------------------------
# Wi-Fi
#
# Sniffer does not need 10 static RX buffers. Four is enough for
# management-frame capture and frees the rest for the general DMA pool.
# AMPDU disabled to fix SoftAP client disconnects.
# ---------------------------------------------------------------------------
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n

# ---------------------------------------------------------------------------
# Bluetooth / NimBLE
#
# NimBLE only. Bluedroid must be OFF — it was enabled in the previous
# defaults file, which contradicts CONFIG_BT_NIMBLE_ENABLED and wastes
# nothing but also does not work correctly (both stacks cannot run).
#
# The CONFIG_BT_BLE_42_* entries that used to live here are Bluedroid
# settings and have no effect under NimBLE. Removed.
# ---------------------------------------------------------------------------
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_PINNED_TO_CORE_1=y
CONFIG_BT_NIMBLE_PINNED_TO_CORE_0=n

# ---------------------------------------------------------------------------
# Console — UART0 (physical pins), NOT USB-Serial-JTAG
#
# UART0 is required on this build. USB-Serial-JTAG shares the physical
# USB port with USB-OTG (TinyUSB). If USJ console is enabled, it fights
# TinyUSB for the port and breaks the composite device enumeration.
# UART0 is on GPIO43/44 (pin header on the T-Dongle-S3) and coexists
# cleanly with the composite USB device.
#
# The Kconfig "console backend" is a choice — setting UART_DEFAULT=y
# implicitly disables the others. The explicit "is not set" lines below
# make that unambiguous when migrating from the previous defaults file
# that had USB_SERIAL_JTAG=y.
# ---------------------------------------------------------------------------
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG is not set
# CONFIG_ESP_CONSOLE_USB_CDC is not set
# CONFIG_ESP_CONSOLE_UART_CUSTOM is not set
# CONFIG_ESP_CONSOLE_NONE is not set
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG is not set
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_ROM_SERIAL_PORT_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# ---------------------------------------------------------------------------
# Watchdog
# ---------------------------------------------------------------------------
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15

# ---------------------------------------------------------------------------
# TinyUSB — composite device: CDC (serial) + HID (keyboard) + MSC (read-only)
# ---------------------------------------------------------------------------

# ---- DMA ----
# Keeps the MSC and HID controllers off the DMA path, reducing pressure
# on the small internal heap during composite bring-up.
CONFIG_TINYUSB_DMA_DISABLE=y

# ---- VID / PID ----
# CRITICAL: these must be present in sdkconfig.defaults.
# If they are lost (e.g. by deleting sdkconfig without them here), the
# regenerated config uses Espressif's default VID/PID (0x303A:xxxx), and
# every Windows host treats the dongle as a brand-new device — new COM
# port, new driver install, broken static COM assignment. The custom
# VID/PID is what makes "M4NT1S-0001" stay a fixed COM port.
CONFIG_TINYUSB_DESC_CUSTOM_VID=0x4A15
CONFIG_TINYUSB_DESC_CUSTOM_PID=0x4201
# CONFIG_TINYUSB_DESC_USE_ESPRESSIF_VID is not set
# CONFIG_TINYUSB_DESC_USE_DEFAULT_PID is not set
CONFIG_TINYUSB_DESC_BCD_DEVICE=0x0100

# ---- Descriptor strings (fallback only) ----
# These are only used if usb_protocol.c does NOT supply its own
# string_desc_arr[] — which it does. Kept here so the Kconfig view
# matches reality and so a future refactor that removes the override
# still produces sane strings. The actual enumeration strings come from
# usb_protocol.c: "M4NT1S" / "T-Dongle S3 Lab" / "M4NT1S-0001".
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="M4NT1S"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="T-Dongle S3 Lab"
CONFIG_TINYUSB_DESC_CDC_STRING="M4NT1S CDC"

# ---- CDC ----
# Required by usb_protocol.c's tinyusb_cdcacm_init() call. These are
# the internal FIFO sizes used by esp_tinyusb, not the USB endpoint
# sizes (which are set by TUD_CDC_DESCRIPTOR in usb_protocol.c to 64).
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_CDC_RX_BUFSIZE=512
CONFIG_TINYUSB_CDC_TX_BUFSIZE=512
CONFIG_TINYUSB_CDC_EP_BUFSIZE=512

# ---- HID ----
# HID_COUNT=1 → single HID keyboard for BadUSB payload delivery.
CONFIG_TINYUSB_HID_COUNT=1

# ---- MSC ----
# MSC_ENABLED → exposes the "M4NT1S" mass-storage volume containing
#   payload.ps1, so the HID payload can execute it via a short cradle
#   one-liner instead of typing thousands of characters.
# MSC_BUFSIZE=512 → one sector per transfer, matches the FAT12 sector
#   size in usb_msc.c, enough throughput for the 32 KB read-only volume.
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=512