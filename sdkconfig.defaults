# sdkconfig.defaults — M4NT1S
#
# sdkconfig.defaults is only read when sdkconfig does not exist.
# To apply changes:
#     rm sdkconfig  (or: del sdkconfig on Windows)
#     idf.py fullclean
#     idf.py build
# Do not edit sdkconfig directly.

# ---------------------------------------------------------------------------
# Target and flash
# ---------------------------------------------------------------------------
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---------------------------------------------------------------------------
# Stack and heap sizing
# ---------------------------------------------------------------------------
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_LV_MEM_SIZE=24576

# ---------------------------------------------------------------------------
# Fonts — ui.c uses 14 for the menu, 28 for the backdrop label
# ---------------------------------------------------------------------------
CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_UNSCII_8=y

# ---------------------------------------------------------------------------
# Wi-Fi
# ---------------------------------------------------------------------------
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n

# ---------------------------------------------------------------------------
# Bluetooth / NimBLE — BROADCASTER-ONLY TRIM
#
# This firmware only ever advertises. It never accepts connections,
# never scans, never pairs, never bonds. Every role and buffer that
# supports those capabilities is disabled here so that the NimBLE
# footprint fits in the single contiguous DMA block that survives a
# Wi-Fi teardown on the no-PSRAM S3.
#
# If you later add a connectable feature (e.g. a real peripheral
# payload that requires pairing), re-enable:
#     CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
#     CONFIG_BT_NIMBLE_SM_SC=y
# and expect to raise BLE_MIN_CONTIGUOUS_BYTES in ble_spam.c.
# ---------------------------------------------------------------------------
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y

# Roles — broadcaster only. Peripheral disabled, central/observer off.
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n

# Core pinning
CONFIG_BT_NIMBLE_PINNED_TO_CORE_1=y
CONFIG_BT_NIMBLE_PINNED_TO_CORE_0=n

# Host state — minimal. No connections, no bonds, no CCCDs needed for
# advertising-only operation, but leave the structures non-zero because
# a couple of NimBLE initialisation paths still touch them.
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=1
CONFIG_BT_NIMBLE_MAX_CCCDS=2
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=64
CONFIG_BT_NIMBLE_L2CAP_COC_MAX_NUM=0
CONFIG_BT_NIMBLE_GATT_MAX_PROCS=1

# Security Manager — off. No pairing, no bonding, no SM protocol.
CONFIG_BT_NIMBLE_SM_LEGACY=n
CONFIG_BT_NIMBLE_SM_SC=n

# HCI transport mbuf pools. Broadcaster sends one short payload every
# ~40 ms; 6 in each direction plus 5 events is generous.
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=6
CONFIG_BT_NIMBLE_TRANSPORT_ACL_TO_LL_COUNT=6
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=5
CONFIG_BT_NIMBLE_TRANSPORT_EVT_DISCARD_COUNT=5

# Controller — THIS IS THE BIG ONE.
# Default BLE_MAX_ACT is 10, which allocates ten independent controller
# contexts (connection state, scheduling slots, ACL buffers, encryption
# state). The spam loop only ever has one advertising set open at a
# time (ble_gap_adv_stop() precedes every ble_gap_adv_start()), so 1
# is correct and reclaims roughly 15 KB contiguous.
CONFIG_BT_CTRL_BLE_MAX_ACT=1
CONFIG_BT_CTRL_BLE_STATIC_ACL_TX_BUF_NB=2

# HCI efficiency mode — smaller transport headers, fewer intermediate
# buffers between host and controller.
CONFIG_BT_CTRL_MODE_EFF=y
CONFIG_BT_CTRL_HCI_TL_EFF=y

# Wi-Fi / BLE coexistence — safe to disable because this firmware
# refuses to start Wi-Fi after NimBLE is resident (see main.cpp
# ensure_wifi_ready_for_mode). Once Wi-Fi is torn down, only BLE is
# active for the rest of the boot, so the coexistence scheduler never
# has anything to arbitrate. Removes ~4 KB.
#
# If the linker complains about a missing coexistence symbol (unlikely
# in IDF 5.5), remove this single line and rebuild.
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=n

# ---------------------------------------------------------------------------
# Console — UART0 (physical pins), NOT USB-Serial-JTAG
# ---------------------------------------------------------------------------
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG is not set
# CONFIG_ESP_CONSOLE_USB_CDC is not set
# CONFIG_ESP_CONSOLE_UART_CUSTOM is not set
# CONFIG_ESP_CONSOLE_NONE is not set
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG is not set
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_ROM_SERIAL_PORT_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# ---------------------------------------------------------------------------
# Watchdog
# ---------------------------------------------------------------------------
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15

# ---------------------------------------------------------------------------
# TinyUSB — composite device: CDC (serial) + HID (keyboard) + MSC (read-only)
# ---------------------------------------------------------------------------
CONFIG_TINYUSB_DMA_DISABLE=y

# ---- VID / PID ----
CONFIG_TINYUSB_DESC_CUSTOM_VID=0x4A15
CONFIG_TINYUSB_DESC_CUSTOM_PID=0x4201
# CONFIG_TINYUSB_DESC_USE_ESPRESSIF_VID is not set
# CONFIG_TINYUSB_DESC_USE_DEFAULT_PID is not set
CONFIG_TINYUSB_DESC_BCD_DEVICE=0x0100

# ---- Descriptor strings (fallback only) ----
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="M4NT1S"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="T-Dongle S3 Lab"
CONFIG_TINYUSB_DESC_CDC_STRING="M4NT1S CDC"

# ---- CDC ----
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_CDC_RX_BUFSIZE=512
CONFIG_TINYUSB_CDC_TX_BUFSIZE=512
CONFIG_TINYUSB_CDC_EP_BUFSIZE=512

# ---- HID ----
CONFIG_TINYUSB_HID_COUNT=1

# ---- MSC ----
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=512